# Environment
NODE_ENV=development
PORT=5000

# MongoDB connection string
# Local:   mongodb://localhost:27017/sr7hub
# Atlas:   mongodb+srv://<user>:<password>@cluster.xxxxx.mongodb.net/sr7hub?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/sr7hub

# JWT — use a long random string (min 32 chars) in production
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (no spaces)
CORS_ORIGINS=http://localhost:5173